# SMTP connection
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Sender / reply-to details
MAIL_FROM="njoy-gadgets <your-email@gmail.com>"
ADMIN_EMAIL=your-email@gmail.com

# Used to build absolute logo/image URLs inside the email
PUBLIC_SITE_URL=https://njoygadgets.com
# Optional: override the logo URL completely
# EMAIL_LOGO_URL=https://njoygadgets.com/website/images/njoy-logo.png

# Support details shown in the email
SUPPORT_EMAIL=support@njoygadgets.com
SUPPORT_PHONE=+234 806 648 6351

# Web server
PORT=3000
# Comma-separated list of allowed origins (required for cross-origin requests).
# Local development defaults already allow:
# http://localhost:5500, http://127.0.0.1:5500, http://localhost:5501,
# http://127.0.0.1:5501, http://localhost:8080, http://127.0.0.1:8080
# Add your production storefront origin here when deploying:
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:8080,http://127.0.0.1:8080
